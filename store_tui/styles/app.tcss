/* Snap Store TUI - single application stylesheet. */

/* ---------------------------------------------------------------- app shell */
#footer {
    dock: bottom;
    height: 1;
    background: $panel;
}

#footer Footer {
    dock: none;
    width: 1fr;
    height: 1;
}

Footer {
    background: $panel;
}

#position-count {
    width: 12;
    padding-right: 1;
    content-align: right middle;
    color: $text-muted;
}

#results-table {
    height: 1fr;
}

#empty-state {
    width: 100%;
    height: auto;
    padding: 1 0;
    text-align: center;
    color: $text-muted;
}

/* ---------------------------------------------------------------- shared bits */
.section-title {
    text-style: bold;
    color: $text-muted;
    padding: 0 1;
}

.screen-title {
    text-align: center;
    text-style: bold;
    padding-bottom: 1;
}

/* ---------------------------------------------------------------- category picker */
CategoryScreen #category-container {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 2;
}

CategoryScreen #category-list {
    width: 60%;
    max-height: 80%;
    border: round $border;
    background: $panel;
}

/* ---------------------------------------------------------------- search */
SearchScreen {
    align-horizontal: center;
}

SearchScreen #search-container {
    width: 60%;
    height: auto;
    margin-top: 2;
    padding: 1 2;
    border: round $border;
    background: $panel;
}

/* ---------------------------------------------------------------- snap details */
SnapScreen #snap-header {
    height: auto;
    padding: 0 1;
}

SnapScreen Footer {
    height: 1;
}

.snap-title {
    text-style: bold;
    margin-right: 2;
}

.snap-publisher {
    color: $text-muted;
}

.snap-summary {
    padding: 0 1;
    text-style: italic;
    color: $text-muted;
}

#snap-scroll {
    height: 1fr;
    margin: 1;
    padding: 1;
    border: round $border;
    background: $panel;
    scrollbar-size-vertical: 1;
}

#snap-card {
    height: auto;
    padding: 0;
    background: transparent;
}

.snap-description {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

.snap-description Markdown {
    height: auto;
    background: transparent;
}

.snap-details {
    width: 40;
    min-width: 28;
    padding-left: 1;
    border-left: round $border;
}

#snap-icon {
    width: auto;
    height: auto;
    padding: 0 1 1 1;
}

.details-item {
    padding: 0 1;
    text-style: bold;
}

.link {
    color: $primary;
    text-style: underline;
}

.link:hover {
    background: $accent;
}

/* ---------------------------------------------------------------- install */
InstallScreen Footer {
    height: 1;
}

#install-body {
    height: 1fr;
}

#install-channels {
    width: 1fr;
    padding: 0 1;
}

#install-main {
    width: 3fr;
    padding: 0 1;
}

#channel-list {
    height: 1fr;
    border: round $border;
    background: $panel;
}

#install-unavailable {
    padding: 1;
    color: $text-muted;
}

#install-detail {
    height: 2fr;
}

#channel-tree {
    width: 1fr;
    padding: 0 1;
    border: round $border;
    background: $panel;
}

#channel-tree > Tree {
    width: 1fr;
    height: 1fr;
    border: none;
}

#install-settings {
    width: 34;
    min-width: 30;
    padding: 0 1;
    border: round $border;
    background: $panel;
}

#settings-list {
    height: 1fr;
}

#install-actions {
    height: auto;
    padding: 1 0;
}

#install-actions Button {
    margin-right: 1;
}

#install-progress {
    height: auto;
}

#install-status {
    height: auto;
    padding: 0 1;
    color: $warning;
}

#install-progress > Horizontal {
    height: 3;
    align-vertical: middle;
}

#install-progress-bar {
    width: 1fr;
}

#install-progress-bar Bar {
    width: 1fr;
}

.progress-message {
    width: auto;
    padding-left: 1;
    color: $text-muted;
}

/* ---------------------------------------------------------------- error */
ErrorScreen {
    align: center middle;
}

#error-container {
    width: 80%;
    height: 80%;
}

#error-card {
    width: 100%;
    height: 100%;
    padding: 1;
    border: round $border;
    background: $panel;
}

#error-title {
    text-style: bold;
    color: $error;
    padding-bottom: 1;
}

#error-traceback {
    height: 1fr;
    background: $surface;
}

#error-actions {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}
